{
  "openapi": "3.1.0",
  "info": {
    "title": "Todd Personal Coach API",
    "version": "2.0.0",
    "description": "Private Supabase-backed coaching API for Todd's training, recovery, nutrition, workout planning, travel mode, and iPhone Shortcut actions."
  },
  "servers": [
    {
      "url": "https://todd-personal-coach.netlify.app"
    }
  ],
  "paths": {
    "/api/coach/dashboard": {
      "get": {
        "operationId": "getCoachDashboard",
        "summary": "Get current coaching dashboard and profile context",
        "description": "Returns the current coaching dashboard from Supabase, including coach_state, readiness, training, nutrition, body, gym, and recent context where available.",
        "parameters": [
          {
            "name": "full",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["0", "1"]
            },
            "description": "Set to 1 for full Supabase context instead of the compact dashboard."
          }
        ],
        "responses": {
          "200": {
            "description": "Current coach dashboard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/coach-today": {
      "get": {
        "operationId": "getCoachToday",
        "summary": "Get today's coach decision brief",
        "description": "Returns the daily call, evidence, plan, safety guardrails, tracking list, data quality warnings, and supporting dashboard context. Apple Health is supporting evidence only.",
        "responses": {
          "200": {
            "description": "Daily coach decision brief",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachTodayResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/sync-status": {
      "get": {
        "operationId": "getSyncStatus",
        "summary": "Check coach source sync status",
        "description": "Returns source freshness and sync status for coach data, including Apple Health as supporting evidence only.",
        "responses": {
          "200": {
            "description": "Coach source sync status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/message": {
      "post": {
        "operationId": "sendCoachMessage",
        "summary": "Send a chat message to coach",
        "description": "Logs a user message, runs deterministic readiness/nutrition/gym gates, optionally polishes the response with OpenAI, logs the coach decision, and returns a structured coaching response.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoachMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Coach reply and structured decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachDecisionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/brief": {
      "post": {
        "operationId": "getMorningCoachBrief",
        "summary": "Build a morning coach brief",
        "description": "Runs the coach engine with brief intent for iPhone Shortcut or Custom GPT morning check-ins.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DirectCoachActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Brief response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectCoachActionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/workout": {
      "post": {
        "operationId": "buildTodayWorkout",
        "summary": "Build today's or an upcoming workout",
        "description": "Builds a deterministic workout whenever Todd explicitly asks for one. Schedule guides the default: generic today requests on non-strength days return the planned goal-support/rest session, explicit strength requests can return a controlled modified strength option when no Red safety gate exists, and Red safety returns a recovery/safety session instead of hard training. Passive today checks should use getCoachToday. Render decision.exercise_coaching_readout when present: it is the concise GPT-facing per-exercise readout with Rack/Motra entry name, tracking app, floor/equipment, prescription, purpose, cues, safety modification, progression target, and logging note.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DirectCoachActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workout response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectCoachActionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/nutrition-closeout": {
      "post": {
        "operationId": "nutritionCloseout",
        "summary": "Evaluate today's nutrition",
        "description": "Uses Garmin Connect+ Nutrition as the primary nutrition source when complete daily totals are available, with manual Coach closeout fallback.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DirectCoachActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nutrition closeout response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectCoachActionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/post-workout": {
      "post": {
        "operationId": "postWorkoutDebrief",
        "summary": "Submit or request a post-workout debrief",
        "description": "Uses workout feedback to prepare the next-session adjustment and logs the coach decision.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DirectCoachActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post-workout response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectCoachActionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/observations": {
      "post": {
        "operationId": "recordCoachObservation",
        "summary": "Record a reviewable coach memory observation",
        "description": "Stores one durable, evidence-based coach observation in Supabase. Memory is reviewable and advisory only; it cannot override current safety gates, BP, migraine, asthma, sharp pain, doctor guidance, Garmin readiness, Rack/Motra strength logs, or Garmin Nutrition totals.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoachObservationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded coach memory observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachObservationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/memory": {
      "get": {
        "operationId": "listCoachMemory",
        "summary": "List active or reviewable coach memory",
        "description": "Returns compact coach observations for Todd review or Custom GPT context. By default, this lists active memory and excludes data-sync observations.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["proposed", "active", "needs_review", "retired", "superseded", "all"]
            },
            "description": "Observation status or lifecycle bucket to list. Proposed maps to needs_review storage; superseded maps to retired storage. Default is active."
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional memory category filter."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "include_data_sync",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["0", "1"],
              "default": "0"
            },
            "description": "Set to 1 to include Apple Health and other data-sync observations."
          }
        ],
        "responses": {
          "200": {
            "description": "Coach memory list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachMemoryListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/memory/correct": {
      "post": {
        "operationId": "correctCoachMemory",
        "summary": "Correct an existing coach memory observation",
        "description": "Updates a coach memory observation when Todd says it is wrong or needs refinement. The previous wording is preserved in raw audit metadata.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoachMemoryCorrectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Corrected coach memory observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachObservationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/memory/retire": {
      "post": {
        "operationId": "retireCoachMemory",
        "summary": "Retire a wrong or outdated coach memory observation",
        "description": "Marks a memory observation retired or superseded so it no longer appears in active coach context.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoachMemoryRetireRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retired coach memory observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachObservationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/motra-template": {
      "post": {
        "operationId": "buildMotraDebriefTemplate",
        "summary": "Build an exercise-level Motra debrief template",
        "description": "Parses Motra exported workout text and returns an exercise-name template before the final post-workout debrief is submitted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MotraTemplateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Motra debrief template",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MotraTemplateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/intake": {
      "post": {
        "operationId": "submitCoachIntake",
        "summary": "Submit structured coach intake",
        "description": "Stores structured health and coaching data such as BP readings, Garmin Nutrition or manual food summaries, body metrics, recovery, activities, strength sessions, workout feedback, doctor notes, or coach notes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoachIntakeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Intake stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CoachIntent": {
        "type": "string",
        "enum": ["general", "brief", "build_workout", "evaluate_data", "nutrition_check", "post_workout", "travel_mode"]
      },
      "CoachMessageRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "description": "The user's message to coach."
          },
          "intent": {
            "$ref": "#/components/schemas/CoachIntent",
            "default": "general"
          },
          "channel": {
            "type": "string",
            "default": "chatgpt-gpt"
          },
          "raw": {
            "type": "object",
            "description": "Optional source metadata.",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "DirectCoachActionRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "intent": {
            "$ref": "#/components/schemas/CoachIntent"
          },
          "requested_session_type": {
            "type": "string",
            "enum": ["workout", "strength", "goal_support", "recovery"],
            "description": "Optional session request. Use strength for explicit lifting requests, recovery for safety/recovery sessions, and goal_support for walk/Zone 2/mobility sessions."
          },
          "schedule_override": {
            "type": "boolean",
            "description": "True only when Todd explicitly asks to override the default schedule. Red safety gates still prevent hard training."
          },
          "target_date": {
            "type": "string",
            "format": "date",
            "description": "Optional target date in the user's timezone."
          },
          "target_day": {
            "type": "string",
            "description": "Optional target weekday such as Wednesday."
          },
          "timezone": {
            "type": "string",
            "default": "Asia/Taipei"
          },
          "channel": {
            "type": "string",
            "default": "iphone-shortcut"
          },
          "raw": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "CoachObservation": {
        "type": "object",
        "description": "Reviewable coach memory observation from Supabase. It is advisory memory, not fresh sensor data and not a safety override.",
        "properties": {
          "id": {
            "type": ["string", "null"]
          },
          "observation_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "category": {
            "type": ["string", "null"]
          },
          "observation": {
            "type": ["string", "null"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "status": {
            "type": ["string", "null"],
            "enum": ["active", "needs_review", "retired", null]
          },
          "lifecycle_status": {
            "type": ["string", "null"],
            "enum": ["proposed", "active", "needs_review", "retired", "superseded", null]
          },
          "action": {
            "type": ["string", "null"]
          },
          "action_taken": {
            "type": ["string", "null"]
          },
          "review_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "source": {
            "type": ["string", "null"]
          },
          "action_contexts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_used_at": {
            "type": ["string", "null"]
          },
          "supersedes": {
            "type": ["string", "null"]
          },
          "replaced_by": {
            "type": ["string", "null"]
          },
          "priority": {
            "type": ["string", "null"]
          },
          "relevance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "freshness_label": {
            "type": ["string", "null"],
            "description": "Always memory for retrieved context; this is not fresh sensor data."
          },
          "sensor_data": {
            "type": "boolean"
          },
          "created_at": {
            "type": ["string", "null"]
          },
          "updated_at": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": true
      },
      "CoachMemoryContext": {
        "type": "object",
        "description": "Compact memory context retrieved from coach_observations. Safety gates and current data override it.",
        "properties": {
          "summary": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "const": "coach_observations"
          },
          "relevant_observations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoachObservation"
            }
          },
          "memory_warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "policy": {
            "type": "object",
            "additionalProperties": true
          },
          "retrieval": {
            "type": "object",
            "additionalProperties": true
          },
          "last_updated": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": true
      },
      "CoachObservationRequest": {
        "type": "object",
        "required": ["observation"],
        "properties": {
          "observation": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "Recommended categories include training_preference, exercise_preference, pain_pattern, safety_constraint, recovery_pattern, nutrition_preference, coaching_style, schedule_preference, equipment_constraint, repeated_question, user_correction, and workout_response_pattern."
          },
          "observation_date": {
            "type": "string",
            "format": "date"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "default": "medium"
          },
          "status": {
            "type": "string",
            "enum": ["proposed", "active", "needs_review", "retired", "superseded"],
            "default": "active"
          },
          "action": {
            "type": "string",
            "description": "How Coach should use this observation."
          },
          "action_taken": {
            "type": "string"
          },
          "review_date": {
            "type": "string",
            "format": "date"
          },
          "source": {
            "type": "string",
            "default": "custom-gpt"
          },
          "action_contexts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "raw": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "CoachObservationResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "action": {
            "type": "string"
          },
          "observation": {
            "$ref": "#/components/schemas/CoachObservation"
          }
        },
        "additionalProperties": true
      },
      "CoachMemoryListResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "action": {
            "type": "string",
            "const": "list-memory"
          },
          "count": {
            "type": "integer"
          },
          "memories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoachObservation"
            }
          }
        },
        "additionalProperties": true
      },
      "CoachMemoryCorrectionRequest": {
        "type": "object",
        "required": ["observation_id", "corrected_observation"],
        "properties": {
          "observation_id": {
            "type": "string"
          },
          "corrected_observation": {
            "type": "string"
          },
          "correction_note": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "action": {
            "type": "string"
          },
          "review_date": {
            "type": "string",
            "format": "date"
          },
          "raw": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "CoachMemoryRetireRequest": {
        "type": "object",
        "required": ["observation_id"],
        "properties": {
          "observation_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "replacement_observation_id": {
            "type": "string"
          },
          "raw": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "MotraTemplateRequest": {
        "type": "object",
        "required": ["motra_text"],
        "properties": {
          "motra_text": {
            "type": "string",
            "description": "Raw text exported from Motra."
          }
        },
        "additionalProperties": true
      },
      "MotraTemplateResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "action": {
            "type": "string",
            "const": "motra-template"
          },
          "debrief_template": {
            "type": "string"
          },
          "parsed_motra": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "DailyCoachSummary": {
        "type": "object",
        "properties": {
          "daily_call": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "enum": ["Green", "Yellow", "Orange", "Red"]
              },
              "readiness_tier": {
                "type": "string"
              },
              "decision": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "why": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "todays_plan": {
            "type": "object",
            "additionalProperties": true
          },
          "safety_guardrails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "what_to_track_today": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rack_motra_handoff": {
            "type": "object",
            "description": "Copy-friendly Rack-first handoff. Generated workouts include Exercise | Equipment | Sets x Reps x Load entry lines plus separate coaching and safety notes. Motra names may appear as legacy aliases.",
            "additionalProperties": true
          },
          "confidence_data_quality": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "CoachTodayResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DailyCoachSummary"
          },
          {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "daily_summary": {
                "$ref": "#/components/schemas/DailyCoachSummary"
              },
              "brief": {
                "type": "object",
                "additionalProperties": true
              },
              "current": {
                "type": "object",
                "additionalProperties": true
              },
              "recent": {
                "type": "object",
                "additionalProperties": true
              },
              "supporting_evidence": {
                "type": "object",
                "additionalProperties": true
              },
              "coach_memory_context": {
                "$ref": "#/components/schemas/CoachMemoryContext"
              },
              "source_context": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "SyncStatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "apple_health": {
            "type": "object",
            "description": "Apple Health freshness and upload status as supporting evidence only.",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "CoachDecision": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
